{
    "name": "waybar",
    "layer": "top",
    "position": "top",
    "margin-top": 8,
    "margin-left": 12,
    "margin-right": 12,
    "margin-bottom": 0,
    "modules-left": [
        "hyprland/workspaces",
        "custom/timer",
        "custom/todo",
        "tray",
        "custom/music"
    ],
    // "modules-center": [
    //     // "custom/music"
    // ],
    "modules-right": [
        "custom/mic",
        "custom/camera",
        "custom/screenshare",
        "cpu",
        "memory",
        "custom/gpu",
        "pulseaudio#output",
        "pulseaudio#mic",
        "clock",
        "battery"
    ],
    "hyprland/workspaces": {
        "format": "{name}",
        "format-icons": {
            "active": "● ",
            "default": "● "
        }
    },
    "cpu": {
        "format": " | C:{usage}%  ",
        "interval": 2
    },
    "memory": {
        "format": "M:{used:0.1f}G  ",
        "interval": 2
    },
    "custom/gpu": {
        "exec": "~/.config/waybar/scripts/gpu.sh",
        "interval": 2,
        "format": "{}|",
        "tooltip": false
    },

"custom/mic": {
    "format": "{}",
    "exec": "echo '  '",
    "exec-if": "~/.config/waybar/scripts/status_device.sh mic",
    "interval": 1,
    "tooltip": true,
    "tooltip-format": "Microphone in use"
},
"custom/camera": {
    "format": "{}",
    "exec": "echo ''",
    "exec-if": "~/.config/waybar/scripts/status_device.sh camera",
    "interval": 1,
    "tooltip": true,
    "tooltip-format": "Camera in use"
},
"custom/screenshare": {
    "format": "{}",
    "exec": "echo ' '",
    "exec-if": "~/.config/waybar/scripts/status_device.sh screenshare",
    "interval": 1,
    "tooltip": true,
    "tooltip-format": "Screen is being shared"
},
"custom/todo": {
    "format": " {} |",
    "return-type": "json",
    "exec": "~/.config/waybar/scripts/todo.sh",
    "on-click": "~/.config/waybar/scripts/todo.sh --menu",
    "interval": 3600,
    "signal": 9,
    "tooltip": true
},

    "pulseaudio#output": {
        "format": "| V:{volume}%  ",
        "format-bluetooth": "{icon}  {volume}%  ",
        "format-bluetooth-muted": " {icon}   ",
        "format-muted": "| M  ",
        "on-click": "pamixer --toggle-mute",
        "on-click-right": "pavucontrol -t 3",
        "tooltip": true,
        "tooltip-format": "{desc} | {volume}%"
    },
    "pulseaudio#mic": {
        "format": "{format_source} |",
        "format-source": "M:{volume}%",
        "format-source-muted": " M",
        "on-click": "pamixer --default-source --toggle-mute",
        "on-click-right": "pavucontrol -t 4",
        "on-scroll-up": "pamixer --default-source -i 5",
        "on-scroll-down": "pamixer --default-source -d 5",
        "scroll-step": 5,
        "tooltip-format": "{source_desc} | {source_volume}%"
    },
    "clock": {
        "format": "| {:%a, %B %d %H:%M:%S} | ",
        "interval": 1,
        "tooltip": false
    },
    "battery": {
        "interval": 5,
        "full-at": 100,
        "design-capacity": false,
        "states": {
            "critical": 20,
            "low": 30,
            "medium": 75
        },
        "format": "B:{capacity}% ",
        "format-charging": "C:{capacity}% ",
        "format-plugged": "PNC:{capacity}% ",
        "format-full": "Full ",
        "format-alt": "TOE:{time} ",
        "format-icons": [
            " ",
            " ",
            " ",
            " ",
            " "
        ]
    },
    "tray": {
        "icon-size": 20,
        "spacing": 10
    },
    "custom/timer": {
        "format": " | {} ",
        "exec": "~/.config/waybar/scripts/timer.sh output",
        "interval": 1,
        "on-click-right": "~/.config/waybar/scripts/timer.sh toggle",
        "on-click": "~/.config/waybar/scripts/timer.sh menu"
    },
    "custom/music": {
        "format": "{}",
        "exec": "~/.config/waybar/scripts/music.sh",
        "exec-if": "playerctl status",
        "return-type": "json",
        "interval": 2,
        "on-click": "~/.config/waybar/scripts/music.sh previous",
        "on-click-right": "~/.config/waybar/scripts/music.sh next",
        "on-click-middle": "~/.config/waybar/scripts/music.sh toggle",
        "tooltip": true
    }
}
